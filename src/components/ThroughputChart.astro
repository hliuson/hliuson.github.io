---
// Roofline ceiling on decode throughput on an RTX 2080 Ti, at the largest batch
// that fits in VRAM. For batch size B, one decode step takes
//   max(bytes / bandwidth, B * flopsPerToken / peakFlops)
// where bytes = every weight read once (shared across the batch) + each sequence's
// full KV cache / recurrent state. Throughput = B / step time, and the larger of
// the two terms is the constraint that binds.
//   B = floor((vram - weightBytesStored) / kvBytes)
// Weights are 16-bit. Activations, workspace and kernel efficiency are ignored.

interface Attn {
  layers: number;
  qHeads: number;
  headDim: number;
  window?: number; // keys attended by a local layer; omitted for global layers
}
interface Linear {
  layers: number;
  heads: number;
  dk: number;
  dv: number;
}
interface Row {
  model: string;
  stored: number; // params resident in VRAM (millions)
  read: number; // params read per decode step = params in matmuls (millions)
  kv1k: number; // MiB per sequence at 1k context
  kv8k: number; // MiB per sequence at 8k context
  attn: Attn[];
  linear?: Linear[];
  group: number;
}

interface Props {
  bandwidthGBs?: number;
  peakTflops?: number;
  vramGiB?: number;
  rows?: Row[];
}

// Param counts and layer layouts from each model's config.json and safetensors
// metadata on Hugging Face (Nov 2026).
// `read` excludes tables that are only gathered one row per token: Pythia's untied
// input embedding and UV-50M's value embedding (1.05M).
// KLM-1.5's 6 global / 18 linear split is from the KV cache table in the post (its config doesn't say).
const {
  bandwidthGBs = 616,
  peakTflops = 53.8, // fp16 tensor cores with fp32 accumulate
  vramGiB = 11,
  rows = [
    { model: 'UV-50M', stored: 50.86, read: 49.81, kv1k: 1.0, kv8k: 4.5, group: 0,
      attn: [{ layers: 2, qHeads: 8, headDim: 64 }, { layers: 8, qHeads: 8, headDim: 64, window: 256 }] },
    { model: 'KLM-1.5', stored: 98.81, read: 98.81, kv1k: 8.4, kv8k: 50.4, group: 0,
      attn: [{ layers: 6, qHeads: 8, headDim: 64 }], linear: [{ layers: 18, heads: 4, dk: 128, dv: 128 }] },
    { model: 'Pythia-70M', stored: 70.43, read: 70.43 - (50304 * 512) / 1e6, kv1k: 12, kv8k: 96, group: 0,
      attn: [{ layers: 6, qHeads: 8, headDim: 64 }] },
    { model: 'SmolLM-135M', stored: 134.52, read: 134.52, kv1k: 22.5, kv8k: 180, group: 0,
      attn: [{ layers: 30, qHeads: 9, headDim: 64 }] },
    { model: 'Monad', stored: 56.66, read: 56.66, kv1k: 64, kv8k: 512, group: 0,
      attn: [{ layers: 64, qHeads: 4, headDim: 64 }] },
  ],
} = Astro.props;

const MiB = 1024 * 1024;
const bw = bandwidthGBs * 1e9;
const peak = peakTflops * 1e12;
const vram = vramGiB * 1024 * MiB;
const BYTES = 2; // 16-bit weights

// FLOPs per generated token: 2 per matmul weight, QK^T + AV over the attended keys,
// and ~6 dk*dv per head for a gated delta-rule state update and readout.
function flopsPerToken(r: Row, ctx: number) {
  const weights = 2 * r.read * 1e6;
  const attn = r.attn.reduce((s, a) => s + a.layers * 4 * a.qHeads * a.headDim * Math.min(ctx, a.window ?? ctx), 0);
  const linear = (r.linear ?? []).reduce((s, l) => s + l.layers * 6 * l.heads * l.dk * l.dv, 0);
  return weights + attn + linear;
}

function roofline(r: Row, ctx: number, kvMiB: number) {
  const kv = kvMiB * MiB;
  const batch = Math.floor((vram - r.stored * 1e6 * BYTES) / kv);
  const tMem = (r.read * 1e6 * BYTES + batch * kv) / bw;
  const tCompute = (batch * flopsPerToken(r, ctx)) / peak;
  const step = Math.max(tMem, tCompute);
  // Fraction of peak FLOPs in use when running at the roofline.
  return { tps: batch / step, util: tCompute / step };
}

const CTX = 1024;

const fmtTps = (v: number) =>
  v >= 1e4 ? `${Math.round(v / 1e3)}k` : v >= 1e3 ? `${(v / 1e3).toFixed(1)}k` : `${Math.round(v)}`;

// Geometry
const W = 640;
const labelW = 128;
const tpsW = 64; // tokens/s column on the right
const padR = 4;
const top = 26; // room for the column header
const rowH = 26;
const barH = 12;
const groupGap = 12;
const axisH = 44;
const plotL = labelW;
const plotR = W - padR - tpsW - 52; // leave room for the % label after a full bar
const colR = W - padR;
const x = (u: number) => plotL + u * (plotR - plotL);

let yCursor = top;
const placed = rows.map((r, i) => {
  if (i > 0 && r.group !== rows[i - 1].group) yCursor += groupGap;
  const y = yCursor + rowH / 2;
  yCursor += rowH;
  return { ...r, y, ...roofline(r, CTX, r.kv1k) };
});
const plotBottom = yCursor + 4;
const H = plotBottom + axisH;
const ticks = [0, 0.25, 0.5, 0.75, 1];
const divider = placed.find((r, i) => i > 0 && r.group !== placed[i - 1].group);
const dividerY = divider ? divider.y - rowH / 2 - groupGap / 2 : 0;

// Bar with square base and 4px-rounded data end.
const bar = (x0: number, x1: number, yc: number) => {
  const w = Math.max(x1 - x0, 0.5);
  const rr = Math.min(4, w / 2, barH / 2);
  const y0 = yc - barH / 2;
  const y1 = yc + barH / 2;
  return `M${x0},${y0} H${x0 + w - rr} Q${x0 + w},${y0} ${x0 + w},${y0 + rr} V${y1 - rr} Q${x0 + w},${y1} ${x0 + w - rr},${y1} H${x0} Z`;
};
---

<figure class="viz" id="throughput">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="tp-title tp-desc">
    <title id="tp-title">Maximum achievable FLOP utilization at 1k context on an RTX 2080 Ti</title>
    <desc id="tp-desc">
      For each architecture, the fraction of peak FLOPs usable during decode before memory bandwidth becomes the
      limit, at the largest batch that fits in {vramGiB} GiB, with the corresponding tokens per second.
    </desc>

    <text class="col-head" x={colR} y="12" text-anchor="end">tokens/s</text>

    <!-- Grid -->
    {ticks.map((t) => <line class:list={['grid', { base: t === 0 }]} x1={x(t)} x2={x(t)} y1={top - 4} y2={plotBottom} />)}
    {divider && <line class="divider" x1={0} x2={W} y1={dividerY} y2={dividerY} />}

    <!-- Axis -->
    {
      ticks.map((t) => (
        <text class="tick" x={x(t)} y={plotBottom + 16} text-anchor="middle">
          {`${t * 100}%`}
        </text>
      ))
    }
    <text class="axis-title" x={(plotL + plotR) / 2} y={plotBottom + 36} text-anchor="middle">
      max FLOP utilization during decode, 1k context
    </text>

    <!-- Rows -->
    {
      placed.map((r) => (
        <g class:list={['row', { self: r.model === 'UV-50M' }]}>
          <text class="label" x={plotL - 12} y={r.y + 4} text-anchor="end">
            {r.model}
          </text>
          <path class="bar" d={bar(x(0), x(r.util), r.y)} />
          <text class="pct" x={x(r.util) + 6} y={r.y + 4}>
            {`${Math.round(r.util * 100)}%`}
          </text>
          <text class="value" x={colR} y={r.y + 4} text-anchor="end">
            {fmtTps(r.tps)}
          </text>
        </g>
      ))
    }
  </svg>
  <figcaption>
    RTX 2080 Ti: {bandwidthGBs} GB/s memory bandwidth, {peakTflops} TFLOPS fp16 (fp32 accumulate), {vramGiB} GiB.
  </figcaption>
</figure>

<style>
  .viz {
    --c-bar: #1b5fae;
    margin: 2rem 0;
  }
  @media (prefers-color-scheme: dark) {
    .viz {
      --c-bar: #8ac4ff;
    }
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    font-family: var(--sans);
    font-variant-numeric: tabular-nums;
  }
  text {
    fill: var(--muted);
    font-size: 13px;
  }
  .label,
  .value,
  .pct {
    fill: var(--fg);
  }
  .row.self .label,
  .row.self .value,
  .row.self .pct {
    font-weight: 600;
  }
  .grid {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .grid.base {
    stroke: var(--muted);
  }
  .divider {
    stroke: var(--rule);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .bar {
    fill: var(--c-bar);
  }
  figcaption {
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.6rem;
  }
</style>

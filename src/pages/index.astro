---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getPosts, postHref } from '../lib/content';

const posts = await getPosts();
---

<Base isHome>
  <section class="intro">
    <h1>{site.name}</h1>
    <ul class="links">
      {site.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </section>

  <section class="prose">
    <p>
      I am a master's student at the University of Michigan, working with
      Professor <a href="https://silviupitis.com/">Silviu Pitis</a>. My work centers on reward design for open-ended discovery and exploration in reinforcement learning.
    </p>
    <p>
      In summer 2024 I interned at Microsoft Research Asia with Jianxun Lian, adapting LLMs to roleplay
      from very few examples. I graduated from the University of Rochester in 2025 with a BS in Computer
      Science and BA in history.
    </p>
  </section>

  <h2 class="section-title" id="posts">Posts</h2>
  {
    posts.length === 0 ? (
      <p class="empty">Nothing here yet.</p>
    ) : (
      <ul class="entries">
        {posts.map((p) => {
          const d = p.data;
          const meta = [d.kind, d.authors, d.venue].filter(Boolean).join(' · ');
          const href = postHref(p);
          return (
            <li class="entry">
              <span class="year">{d.date.getUTCFullYear()}</span>
              <div>
                <div class="title">{href ? <a href={href}>{d.title}</a> : d.title}</div>
                {meta && <p class="meta">{meta}</p>}
                {d.description && <p class="desc">{d.description}</p>}
                {d.links.length > 0 && (
                  <div class="actions">
                    {d.links.map((l) => <a href={l.href}>{l.label}</a>)}
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    )
  }
</Base>

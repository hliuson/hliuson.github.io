---
import Base from '../layouts/Base.astro';
import { site, teaching } from '../data/site';
import { getPosts, postHref } from '../lib/content';

const posts = await getPosts();
---

<Base isHome wide>
  <div class="home-grid">
    <div class="home-main">
      <section class="intro">
        <h1>{site.name}</h1>
        <ul class="links">
          {site.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
        {site.status && <p class="status">{site.status}</p>}
      </section>

      <section class="prose">
        <p>
          I am a master's student at the University of Michigan, working with
          Professor <a href="https://silviupitis.com/">Silviu Pitis</a>. I am interested in open-ended learning and discovery in machine learning. My current work focuses on the design of set-level rewards for reinforcement learning on language models.
        </p>
        <p>
          I previously interned at Microsoft Research Asia with Jianxun Lian, researching very low parameter methods for few-shot adaptation of LLMs. I graduated from the University of Rochester in 2025 with a BS in Computer
          Science and BA in History. At Rochester, I worked with Lane Hemaspaandra and Michael Chavrimootoo on the computational complexity of manipulating elections. I also worked with Chris Kanan and Jhair Gallardo on learning without backpropagation. My study in history concentrated on the history of capitalism, imperialism, and the political economy of late industrialization, particularly in East Asia.
        </p>
      </section>
    </div>

    <aside class="home-side" aria-labelledby="posts">
      <h2 class="section-title" id="posts">Posts</h2>
      {
        posts.length === 0 ? (
          <p class="empty">Nothing here yet.</p>
        ) : (
          <ul class="entries">
            {posts.map((p) => {
              const d = p.data;
              const meta = [d.kind, d.authors, d.venue].filter(Boolean).join(' · ');
              const href = postHref(p);
              return (
                <li class="entry">
                  <span class="year">{d.date.getUTCFullYear()}</span>
                  <div>
                    <div class="title">{href ? <a href={href}>{d.title}</a> : d.title}</div>
                    {meta && <p class="meta">{meta}</p>}
                    {d.description && <p class="desc">{d.description}</p>}
                    {d.links.length > 0 && (
                      <div class="actions">
                        {d.links.map((l) => <a href={l.href}>{l.label}</a>)}
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )
      }
    </aside>

    <section class="home-teaching" aria-labelledby="teaching">
      <h2 class="section-title" id="teaching">Teaching</h2>
      <p class="compact-note">Teaching assistant, University of Rochester</p>
      <ul class="compact">
        {teaching.map((t) => (
          <li>
            <span class="when">{t.term}</span>
            <span class="what">{t.course}</span>
            <span class="who">{t.instructor}</span>
          </li>
        ))}
      </ul>
    </section>

  </div>
</Base>
